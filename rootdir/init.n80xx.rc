on post-fs-data
    mkdir /data/vendor/sec_keyboard 0700 root root
    restorecon_recursive /data/vendor/sec_keyboard

on boot
    chown system system /sys/class/sec/tsp/dt2w_timeout

on property:debug.tracing.screen_state=1
    stop vendor.sec_keyboard
    start vendor.keyboard_kill

on property:debug.tracing.screen_state=2
    start vendor.sec_keyboard

service vendor.keyboard_kill /vendor/bin/sec_keyboard_kill.sh
    class main
    group system
    oneshot
    disabled
    seclabel u:r:sec_keyboard:s0
