allow ueventd sensors_device:chr_file { relabelfrom relabelto };
allow ueventd sysfs_display:file { open write };
allow ueventd wifi_firmware_path:file relabelto;
allow ueventd sysfs_slab:dir { open read relabelto search };
allow ueventd sysfs_slab:file relabelto;
allow ueventd sysfs_slab:lnk_file relabelto;
allow ueventd display_vendor_data_file:dir { search open read relabelto };
allow ueventd display_vendor_data_file:file relabelto;
allow ueventd display_vendor_data_file:lnk_file relabelto;
allow ueventd sysfs_gpu:lnk_file relabelto;
allow ueventd glgps_exec:file r_file_perms;
allow ueventd self:capability sys_resource;
