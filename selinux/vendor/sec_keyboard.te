# sec_keyboard
type sec_keyboard, domain;
type sec_keyboard_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(sec_keyboard)

allow sec_keyboard self:capability { sys_admin };
allow sec_keyboard input_device:file { read getattr };
allow sec_keyboard dock_device:chr_file { open read write ioctl };
allow sec_keyboard sysfs_devices_system_cpu:dir r_dir_perms;
allow sec_keyboard sysfs_devices_system_cpu:file { read open getattr };
type ttySAC2, domain;
type ttySAC2_exec, exec_type, file_type;
init_daemon_domain(ttySAC2)

# PID state and validation are limited to the keyboard domain.
allow sec_keyboard sec_keyboard_pid_file:dir { search getattr write add_name remove_name };
allow sec_keyboard sec_keyboard_pid_file:file { create getattr open read write setattr rename unlink };
allow sec_keyboard self:dir search;
allow sec_keyboard self:file { getattr open read };
allow vendor_init sec_keyboard_pid_file:dir { create search getattr setattr relabelto };
